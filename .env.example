# GEMINI_API_KEY: Required for Gemini AI API calls (Admin AI Assistant).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key for signing authentication session tokens.
SESSION_SECRET="change-this-in-production"

# Optional Live Razorpay Gateway Credentials (falls back to signed test checkout when unset)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Optional SMTP Configuration for transactional email notifications
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@starfibernet.com"
